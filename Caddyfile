# Serves the static site. Cloudflare Pages reads _headers; nothing else does,
# so the same rules are restated here for a self-hosted deployment.
#
# SITE_ADDRESS comes from .env — see docker-compose.yml in this folder.
#   a hostname  (zeethee.store)  -> Caddy gets a Let's Encrypt certificate
#   :80                          -> plain HTTP, for testing against an IP

{$SITE_ADDRESS} {
	root * /srv

	# The whole repository folder is mounted, so everything that is not the
	# published site has to be refused explicitly: .git would leak the source
	# history, .env the deployment settings.
	@private {
		path /.git /.git/* /.env /.env.* /Caddyfile /docker-compose.yml /README.md /_headers
	}
	respond @private 404

	encode gzip zstd
	file_server {
		hide .git .env* Caddyfile docker-compose.yml
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; script-src 'self' 'unsafe-inline'; frame-ancestors 'self'; base-uri 'none'; form-action 'none'"
		-Server
	}

	@images path *.png *.jpg *.webp *.svg
	header @images Cache-Control "public, max-age=31536000, immutable"

	# This deployment is not the production site. Keeping it out of search
	# results stops a test host outranking the real one, and stops the VPN
	# hostnames on this domain being advertised to crawlers.
	header X-Robots-Tag "noindex, nofollow"

	handle_errors {
		respond "{err.status_code} {err.status_text}"
	}
}
